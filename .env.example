# Bu faylni .env nomi bilan nusxalab, qiymatlarni to'ldiring.
# .env fayli hech qachon git'ga qo'shilmaydi (.gitignore'da).
# Lokal ishlab chiqishda bu fayl shart emas — hammasi avtomatik ishlaydi.

# Yangi kalit yaratish:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=bu-yerga-yangi-maxfiy-kalit

# Serverda: false
DJANGO_DEBUG=false

# Serverda: o'z domeningiz
DJANGO_ALLOWED_HOSTS=takeavia.uz,www.takeavia.uz

# HTTPS bilan ishlaganda
DJANGO_CSRF_TRUSTED_ORIGINS=https://takeavia.uz,https://www.takeavia.uz
